rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function usuarioActivo() {
      return autenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.activo == true;
    }

    function esAdministrador() {
      return usuarioActivo()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "administrador";
    }

    match /usuarios/{uid} {
      // Cada usuario puede consultar su perfil.
      allow get: if autenticado() && request.auth.uid == uid;

      // Crear únicamente el perfil propio como cliente.
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          "nombre", "apellido", "correo",
          "rol", "activo", "created_at"
        ])
        && request.resource.data.keys().hasOnly([
          "nombre", "apellido", "correo",
          "rol", "activo", "created_at"
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.apellido is string
        && request.resource.data.apellido.size() > 0
        && request.resource.data.apellido.size() <= 100
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.correo.matches(
          "^[^@]+@uleam[.]edu[.]ec$"
        )
        && request.resource.data.rol == "cliente"
        && request.resource.data.activo == true
        && request.resource.data.created_at == request.time;

      // La edición de perfiles se implementará después.
      allow update, delete, list: if false;
    }

    match /productos/{productoId} {
      allow read: if usuarioActivo();
      allow create, update, delete: if esAdministrador();
    }

    // Las demás colecciones permanecen bloqueadas.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}